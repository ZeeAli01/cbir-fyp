generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model apikey {
  api_key_id Int       @id @default(autoincrement())
  user_id    String    @db.Uuid
  api_key    String    @unique(map: "api_key_api_key_key") @db.VarChar(255)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  expires_at DateTime? @db.Timestamp(6)
  updated_at DateTime  @default(now()) @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)
  is_deleted Boolean   @default(false)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "api_key_user_id_fkey")
}

model auditlog {
  audit_id         Int        @id @default(autoincrement())
  mri_image_id     Int
  user_id          String     @db.Uuid
  action           String     @db.VarChar(50)
  tumor_type       String?    @db.VarChar(100)
  detection_score  Float?
  cancer_diagnosis Boolean?
  analysis_results String?
  change_date      DateTime   @default(now()) @db.Timestamp(6)
  created_at       DateTime   @default(now()) @db.Timestamp(6)
  updated_at       DateTime   @default(now()) @db.Timestamp(6)
  deleted_at       DateTime?  @db.Timestamp(6)
  is_deleted       Boolean    @default(false)
  mri_images       mri_images @relation(fields: [mri_image_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "audit_log_mri_image_id_fkey")
  users            users      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "audit_log_user_id_fkey")

  @@index([mri_image_id], map: "audit_log_mri_image_id_idx")
  @@index([tumor_type], map: "audit_log_tumor_type_idx")
  @@index([user_id], map: "audit_log_user_id_idx")
}

model image_analysis {
  id                Int         @id @default(autoincrement())
  mri_image_id      Int?
  description       String?
  diagnosis_results String?
  analysis_time     DateTime?   @default(now()) @db.Timestamp(6)
  mri_images        mri_images? @relation(fields: [mri_image_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model mri_images {
  id             Int              @id @default(autoincrement())
  user_id        String?          @db.Uuid
  image_path     String           @db.VarChar(255)
  upload_time    DateTime?        @default(now()) @db.Timestamp(6)
  status         String?          @default("pending") @db.VarChar(50)
  auditlog       auditlog[]
  image_analysis image_analysis[]
  users          users?           @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  similar_cases  similar_cases[]
}

model similar_cases {
  id                 Int         @id @default(autoincrement())
  mri_image_id       Int?
  similar_image_path String?     @db.VarChar(255)
  similarity_score   Float?      @default(0.0)
  retrieved_at       DateTime?   @default(now()) @db.Timestamp(6)
  mri_images         mri_images? @relation(fields: [mri_image_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model userrole {
  role_id     Int       @id @default(autoincrement())
  role_name   String    @unique @db.VarChar(50)
  description String?
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  is_deleted  Boolean   @default(false)
  users       users[]
}

model users {
  user_id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String       @unique @db.VarChar(50)
  email         String       @unique @db.VarChar(100)
  password_hash String       @db.VarChar(255)
  role_id       Int?
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime     @default(now()) @db.Timestamp(6)
  deleted_at    DateTime?    @db.Timestamp(6)
  is_deleted    Boolean      @default(false)
  apikey        apikey[]
  auditlog      auditlog[]
  mri_images    mri_images[]
  userrole      userrole?    @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "user_role_id_fkey")
}
